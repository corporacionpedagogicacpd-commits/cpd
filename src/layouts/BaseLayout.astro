---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Corporación Pedagógica Diversidad — educación inclusiva y salud mental para jóvenes en Colombia.',
} = Astro.props;

const siteName = 'CPD — Corporación Pedagógica Diversidad';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Datos estructurados (SEO): identidad de la organización para Google.
// Se inyecta tal cual en el <head> como JSON-LD.
const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Corporación Pedagógica Diversidad',
  alternateName: ['CPD', 'CorpoDiversidad', 'Corpedagogica'],
  url: 'https://www.corpedagogicadiversidad.org/',
  logo: 'https://www.corpedagogicadiversidad.org/logo.png',
  email: 'corporacionpedagogicacpd@gmail.com',
  foundingDate: '2012-04-27',
  description:
    'Corporación Pedagógica Diversidad: educación inclusiva, apoyo psicosocial y salud mental para jóvenes en Medellín y Antioquia desde 2012.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Calle 47 #43-37',
    addressLocality: 'Medellín',
    addressRegion: 'Antioquia',
    addressCountry: 'CO',
  },
  sameAs: ['https://instagram.com/corpodiversidad'],
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Barra del navegador en móvil: los dos valores y el propio navegador
         elige según su tema activo. -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0b0e" media="(prefers-color-scheme: dark)" />

    <!-- El tema se aplica ANTES de pintar: sin esto, quien tenga el tema oscuro
         guardado vería un destello blanco en cada carga. Es un script inline
         deliberadamente (no un módulo) porque los módulos se difieren. -->
    <script is:inline>
      (function () {
        try {
          var guardado = localStorage.getItem('cpd-tema');
          var oscuro =
            guardado === 'oscuro' ||
            (guardado !== 'claro' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (oscuro) document.documentElement.setAttribute('data-tema', 'oscuro');
        } catch (e) {
          /* localStorage bloqueado: se queda en el tema claro, sin romper nada */
        }
      })();
    </script>

    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Corporación Pedagógica Diversidad" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Motor de scroll (bundeleado por Astro: hash en el nombre = cache busting) -->
    <script>
      import '../scripts/scroll.js';
    </script>

    <!-- JSON-LD (SEO): ficha de la organización -->
    <script type="application/ld+json" set:html={orgSchema} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-brand focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>

    <!-- Barra de progreso de lectura: se llena al bajar por la página -->
    <div class="fixed inset-x-0 top-0 z-50 h-0.5 bg-transparent" aria-hidden="true">
      <div
        data-scroll-progress
        class="scroll-progress h-full origin-left scale-x-0 bg-gradient-to-r from-brand to-accent"
      >
      </div>
    </div>

    <slot name="header" />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
