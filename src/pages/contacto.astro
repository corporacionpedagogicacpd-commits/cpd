---
// Página de contacto: formulario + datos reales de la Corporación.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const datosContacto = {
  email: 'corporacionpedagogicacpd@gmail.com',
  telefono: '+57 300 3079290',
  whatsapp: 'https://wa.me/573003079290',
  instagram: 'https://instagram.com/corpodiversidad',
  // Dirección única de la Corporación (dato confirmado por Ney el 2026-11-03).
  // Antes había dos direcciones distintas en esta página; la de Calle 111e
  // #64a-78 se retiró porque no es la sede.
  direccion: 'Carrera 43 #54-44, piso 5 — Medellín',
  // El código postal es el dato que piden casi todos los formularios
  // (cooperación, convocatorias, convenios): el de 6 dígitos y el ampliado.
  codigoPostal: '050012',
  codigoPostalAmpliado: '050012256',
  // Búsqueda por texto: el enlace corto anterior apuntaba a la dirección vieja.
  mapa: 'https://www.google.com/maps/search/?api=1&query=Carrera%2043%20%2354-44%2C%20Medell%C3%ADn',
};
---

<BaseLayout
  title="Contacto"
  description="Contacta a la Corporación Pedagógica Diversidad (CPD) en Medellín: correo, teléfono, WhatsApp e Instagram. Escríbenos para alianzas y programas."
>
  <Header slot="header" dark />

  <PageHero
    eyebrow="Contacto"
    title="¡Aquí puedes contactarte con nosotros!"
    description="Escríbenos, llámanos o visítanos. Estamos disponibles para escucharte y acompañarte."
  />

  <section class="container-content py-16 sm:py-20" aria-labelledby="form-titulo">
    <!-- grid-cols-1 explícito: sin él la columna implícita se dimensiona a
         max-content y a 320 px el formulario desbordaba 48 px (el ancho lo
         fijaba el contenido más largo, no el viewport). -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
      <!-- Formulario de contacto -->
      <div>
        <h2 id="form-titulo" class="text-3xl">Envíanos un mensaje</h2>
        <form class="mt-8 space-y-5" method="post" action="#">
          <div>
            <label for="nombre" class="block text-sm font-bold text-ink">Nombre</label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              autocomplete="given-name"
              required
              class="mt-2 w-full rounded-lg border border-black/15 bg-surface px-4 py-3 text-ink placeholder:text-ink/40 focus:border-brand focus:outline-none"
              placeholder="Tu nombre"
            />
          </div>

          <div>
            <label for="apellido" class="block text-sm font-bold text-ink">Apellido</label>
            <input
              id="apellido"
              name="apellido"
              type="text"
              autocomplete="family-name"
              required
              class="mt-2 w-full rounded-lg border border-black/15 bg-surface px-4 py-3 text-ink placeholder:text-ink/40 focus:border-brand focus:outline-none"
              placeholder="Tu apellido"
            />
          </div>

          <div>
            <label for="celular" class="block text-sm font-bold text-ink">Celular</label>
            <input
              id="celular"
              name="celular"
              type="tel"
              autocomplete="tel"
              class="mt-2 w-full rounded-lg border border-black/15 bg-surface px-4 py-3 text-ink placeholder:text-ink/40 focus:border-brand focus:outline-none"
              placeholder="+57 300 0000000"
            />
          </div>

          <div>
            <label for="correo" class="block text-sm font-bold text-ink">Correo</label>
            <input
              id="correo"
              name="correo"
              type="email"
              autocomplete="email"
              required
              class="mt-2 w-full rounded-lg border border-black/15 bg-surface px-4 py-3 text-ink placeholder:text-ink/40 focus:border-brand focus:outline-none"
              placeholder="tucorreo@ejemplo.com"
            />
          </div>

          <div>
            <label for="mensaje" class="block text-sm font-bold text-ink">Mensaje</label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="5"
              class="mt-2 w-full rounded-lg border border-black/15 bg-surface px-4 py-3 text-ink placeholder:text-ink/40 focus:border-brand focus:outline-none"
              placeholder="Cuéntanos en qué podemos ayudarte"></textarea>
          </div>

          <button
            type="submit"
            class="rounded-full bg-brand px-6 py-3 text-sm font-bold text-white transition hover:opacity-90"
          >
            Enviar mensaje
          </button>
        </form>
      </div>

      <!-- Datos de contacto reales -->
      <div>
        <h2 class="text-3xl">Nuestros datos</h2>
        <ul class="mt-8 space-y-6">
          <li class="rounded-2xl border border-black/5 p-6 shadow-sm">
            <h3 class="text-lg">Correo electrónico</h3>
            <a href={`mailto:${datosContacto.email}`} class="mt-2 block break-words text-brand hover:underline">
              {datosContacto.email}
            </a>
          </li>

          <li class="rounded-2xl border border-black/5 p-6 shadow-sm">
            <h3 class="text-lg">Teléfono / WhatsApp</h3>
            <a href={datosContacto.whatsapp} class="mt-2 block text-brand hover:underline">
              {datosContacto.telefono}
            </a>
          </li>

          <li class="rounded-2xl border border-black/5 p-6 shadow-sm">
            <h3 class="text-lg">Dirección</h3>
            <a
              href={datosContacto.mapa}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 block text-brand hover:underline"
            >
              {datosContacto.direccion}
            </a>
          </li>

          <li class="rounded-2xl border border-black/5 p-6 shadow-sm">
            <h3 class="text-lg">Código postal</h3>
            <p class="mt-2 text-2xl font-bold tracking-wide text-ink">{datosContacto.codigoPostal}</p>
            <p class="mt-1 text-sm text-ink/75">
              Código postal ampliado: <span class="font-bold text-ink">{datosContacto.codigoPostalAmpliado}</span>
            </p>
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={datosContacto.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-brand px-6 py-3 text-sm font-bold text-brand-ink transition hover:bg-brand/5"
          >
            Instagram
          </a>
          <a
            href={datosContacto.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-accent px-6 py-3 text-sm font-bold text-white transition hover:opacity-90"
          >
            Escríbenos por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
