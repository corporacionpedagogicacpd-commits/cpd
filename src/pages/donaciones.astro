---
// Página de donaciones: razones para donar y enlaces reales de pago (Wompi / Epayco).
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const razones = [
  'Transformar muchas vidas',
  'Crear un cambio duradero',
  'Participar activamente',
  'Aseguras calidad e impacto',
  'Apoyar la educación inclusiva',
  'Fortalecer la salud mental',
  'Impulsar la prevención',
  'Construir equidad',
  'Sostener programas en el tiempo',
];

const wompi = 'https://checkout.wompi.co/l/VPOS_ddGDbY';
const epayco =
  'https://secure.payco.co/checkoutopen/6a93c332-8934-4da4-b33c-f0291b346984';
---

<BaseLayout
  title="Donaciones"
  description="Dona a la Corporación Pedagógica Diversidad y apoya la educación inclusiva, la salud mental y la prevención en Colombia."
>
  <Header slot="header" />

  <section class="border-b border-black/5 bg-gradient-to-b from-brand/5 to-transparent">
    <div class="container-content py-16 sm:py-20">
      <p class="text-sm font-bold uppercase tracking-widest text-brand">Donaciones</p>
      <h1 class="mt-4 max-w-3xl text-4xl leading-tight sm:text-5xl">
        Tu donación sostiene la educación inclusiva
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink/75">
        Gracias a aportes como el tuyo podemos acompañar a jóvenes en riesgo con programas
        pedagógicos, psicosociales y de convivencia.
      </p>
    </div>
  </section>

  <section class="container-content py-16 sm:py-20" aria-labelledby="razones-titulo">
    <p class="text-2xl font-bold text-accent sm:text-3xl">Una donación puede cambiar vidas</p>

    <h2 id="razones-titulo" class="mt-10 text-3xl">9 razones para donar</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        razones.map((razon, i) => (
          <li class="flex items-start gap-3 rounded-2xl border border-black/5 p-5 shadow-sm">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold text-white">
              {i + 1}
            </span>
            <span class="text-ink/85">{razon}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container-content py-16 sm:py-20" aria-labelledby="donar-titulo">
    <h2 id="donar-titulo" class="text-3xl">Donar ahora</h2>
    <p class="mt-4 max-w-2xl text-ink/75">
      Elige el medio que prefieras. Ambos enlaces te llevan a los canales oficiales de la
      corporación.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href={wompi}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-brand px-8 py-4 text-sm font-bold text-white transition hover:opacity-90"
      >
        Donar con Wompi
      </a>
      <a
        href={epayco}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-accent px-8 py-4 text-sm font-bold text-white transition hover:opacity-90"
      >
        Donar con Epayco
      </a>
    </div>

    <!-- Marcador pendiente de validación con el cliente -->
    <p class="mt-6 text-xs text-ink/50">
      [Datos bancarios y certificado de donación pendientes de validación con el cliente]
    </p>
  </section>

  <Footer slot="footer" />
</BaseLayout>
