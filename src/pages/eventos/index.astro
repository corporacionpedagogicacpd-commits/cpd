---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const eventos = (await getCollection('eventos')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);

// Imágenes locales declaradas estáticamente (Astro solo resuelve imports estáticos).
const imagenes: Record<string, ImageMetadata> = {
  'expo-participacion-2026-10-16.jpg': (await import('../../assets/asset-cpd/expo-participacion-2026-10-16.jpg')).default,
  'senderos-neurodiversos-2025-10-25.jpeg': (await import('../../assets/asset-cpd/senderos-neurodiversos-2025-10-25.jpeg')).default,
};
---

<BaseLayout title="Eventos" description="Eventos y jornadas de la Corporación Pedagógica Diversidad.">
  <Header slot="header" dark />

  <PageHero
    eyebrow="Jornadas y encuentros"
    title="Eventos"
    description="Jornadas, talleres y encuentros con la comunidad educativa."
  />

  <section class="container-content py-12">

    {
      eventos.length > 0 ? (
        <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {eventos.map((ev) => (
            <li class="flex flex-col overflow-hidden rounded-2xl border border-black/5 shadow-sm">
              {ev.data.imagen && imagenes[ev.data.imagen] && (
                <Image
                  src={imagenes[ev.data.imagen]}
                  alt={`Afiche del evento ${ev.data.titulo}`}
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="h-56 w-full bg-black/5 object-cover"
                />
              )}
              <div class="flex flex-1 flex-col p-6">
                <time datetime={ev.data.fecha.toISOString()} class="text-xs uppercase tracking-wide text-ink/50">
                  {ev.data.fecha.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
                <h2 class="mt-2 text-xl">{ev.data.titulo}</h2>
                {ev.data.lugar && <p class="mt-1 text-sm text-ink/60">{ev.data.lugar}</p>}
                <p class="mt-3 flex-1 text-ink/75">{ev.data.resumen}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-8 text-ink/60">Aún no hay eventos publicados.</p>
      )
    }

    <p class="mt-12 text-xs text-ink/50">
      [Contenido pendiente de validación con el cliente]
    </p>
  </section>

  <Footer slot="footer" />
</BaseLayout>
