---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

// Programas pedagógicos ofrecidos por la corporación
const programas = [
  {
    titulo: 'Acompañamiento pedagógico',
    texto:
      'Acompañamos a estudiantes y docentes en la construcción de trayectorias educativas flexibles y pertinentes. Trabajamos en territorio con adaptaciones curriculares y seguimiento personalizado.',
  },
  {
    titulo: 'Formación docente',
    texto:
      'Formamos a maestros y agentes educativos en estrategias de educación inclusiva y convivencia escolar. Ofrecemos talleres prácticos, asesoría en aula y comunidades de aprendizaje.',
  },
  {
    titulo: 'Materiales accesibles',
    texto:
      'Diseñamos recursos pedagógicos accesibles y de fácil lectura para distintos niveles y capacidades. Los materiales se adaptan al contexto territorial y se comparten con las instituciones aliadas.',
  },
];
---

<BaseLayout
  title="Educación inclusiva"
  description="Programas de educación inclusiva de la Corporación Pedagógica Diversidad (CPD): acompañamiento pedagógico, formación docente y materiales accesibles."
>
  <Header slot="header" dark />

  <PageHero
    eyebrow="Programas"
    title="Educación"
    description="Nuestros programas pedagógicos están diseñados para que ningún joven quede fuera del sistema educativo. Combinamos acompañamiento en aula, formación docente y producción de materiales accesibles, articulando con instituciones educativas y comunidades del departamento."
  >
  </PageHero>

  <!-- Programas en tarjetas -->
  <section class="container-content py-16 sm:py-20" aria-labelledby="programas-titulo">
    <h2 id="programas-titulo" class="text-3xl">Nuestros programas</h2>
    <p class="mt-3 max-w-2xl text-ink/70">
      Tres líneas de trabajo complementarias que se implementan de forma articulada en cada
      territorio.
    </p>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        programas.map((programa, indice) => (
          <li class="flex flex-col rounded-2xl border border-black/5 p-6 shadow-sm">
            {/* Bloque de color como indicador de tarjeta (sin imágenes) */}
            <span
              class={`mb-4 flex h-12 w-12 items-center justify-center rounded-xl text-lg font-bold text-white ${
                indice === 1 ? 'bg-accent' : 'bg-brand'
              }`}
              aria-hidden="true"
            >
              {indice + 1}
            </span>
            <h3 class="text-xl">{programa.titulo}</h3>
            <p class="mt-3 text-ink/75">{programa.texto}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Llamado a la acción -->
  <section class="border-t border-black/5 bg-brand/5">
    <div class="container-content py-16 sm:py-20">
      <h2 class="text-2xl">¿Tu institución quiere trabajar con nosotros?</h2>
      <p class="mt-3 max-w-2xl text-ink/75">
        Articulamos con instituciones educativas del departamento para llevar estos programas a más
        comunidades.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/nosotros"
          class="rounded-full border border-brand px-6 py-3 text-sm font-bold text-brand-ink transition hover:bg-brand/5"
        >
          Conoce la corporación
        </a>
        <a
          href="/proyectos"
          class="rounded-full bg-brand px-6 py-3 text-sm font-bold text-white transition hover:opacity-90"
        >
          Ver proyectos
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
