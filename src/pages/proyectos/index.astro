---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const proyectos = (await getCollection('proyectos')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);
---

<BaseLayout title="Proyectos" description="Proyectos de la Corporación Pedagógica Diversidad (CPD): inclusión, prevención y salud mental con jóvenes y comunidades en Antioquia.">
  <Header slot="header" dark />

  <PageHero
    eyebrow="Iniciativas"
    title="Proyectos"
    description="Iniciativas de acompañamiento pedagógico y psicosocial para jóvenes en riesgo."
  />

  <section class="container-content py-12">

    {
      proyectos.length > 0 ? (
        <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {proyectos.map((p) => (
            <li class="flex flex-col rounded-2xl border border-black/5 p-6 shadow-sm">
              <time datetime={p.data.fecha.toISOString()} class="text-xs uppercase tracking-wide text-ink/50">
                {p.data.fecha.toLocaleDateString('es-CO', { year: 'numeric', month: 'long' })}
              </time>
              <h2 class="mt-2 text-xl">{p.data.titulo}</h2>
              <p class="mt-3 flex-1 text-ink/75">{p.data.resumen}</p>
              <span class="mt-4 inline-block w-fit rounded-full bg-brand/10 px-3 py-1 text-xs font-bold text-brand">
                {p.data.estado}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-8 text-ink/60">Aún no hay proyectos publicados.</p>
      )
    }

    <p class="mt-12 text-xs text-ink/50">
      [Contenido pendiente de validación con el cliente]
    </p>
  </section>

  <Footer slot="footer" />
</BaseLayout>
