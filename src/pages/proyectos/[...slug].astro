---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);

const todos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
const indice = todos.findIndex((p) => p.id === proyecto.id);
const anterior = indice > 0 ? todos[indice - 1] : todos[todos.length - 1];
const siguiente = indice < todos.length - 1 ? todos[indice + 1] : todos[0];

const numero = String(indice + 1).padStart(2, '0');
const estadoTexto: Record<string, string> = {
  activo: 'En ejecución',
  planificado: 'En búsqueda de aliados',
  finalizado: 'Finalizado',
};

// Migas de pan estructuradas: ayudan a Google a entender la jerarquía
// /proyectos → /proyectos/<slug> y a mostrarla en los resultados.
const migas = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.corpedagogicadiversidad.org/' },
    { '@type': 'ListItem', position: 2, name: 'Proyectos', item: 'https://www.corpedagogicadiversidad.org/proyectos' },
    { '@type': 'ListItem', position: 3, name: proyecto.data.titulo },
  ],
});
---

<BaseLayout
  title={proyecto.data.titulo}
  tituloCompleto={`${proyecto.data.titulo} | Proyectos CPD`}
  description={proyecto.data.resumen}
>
  <Header slot="header" dark />
  <script type="application/ld+json" set:html={migas} />

  <article>
    <!-- ══════════ Apertura: el arte del proyecto como fondo ══════════ -->
    <header class="relative isolate overflow-hidden border-b border-night-line bg-night text-mist">
      <div class="absolute inset-0 opacity-45" aria-hidden="true">
        <ProjectArt variante={proyecto.data.icono} />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-night via-night/90 to-night/40" aria-hidden="true"></div>

      <div class="container-content relative py-12 sm:py-20">
        <nav aria-label="Ruta de navegación" class="text-xs font-bold uppercase tracking-[0.18em] text-mist/55">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="transition hover:text-mist">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/proyectos" class="transition hover:text-mist">Proyectos</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-mist/80">{proyecto.data.linea ?? 'Proyecto'}</li>
          </ol>
        </nav>

        <p class="mt-10 flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-[0.24em]">
          <span class="text-brand">{numero} · {proyecto.data.linea ?? 'Iniciativa'}</span>
          {proyecto.data.periodo && <span class="text-mist/45">{proyecto.data.periodo}</span>}
        </p>

        <h1 class="mt-6 max-w-4xl text-display font-bold">
          <span class="line-mask"><span class="line-inner">{proyecto.data.titulo}</span></span>
        </h1>

        <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-mist/75" style="--reveal-delay:200ms">
          {proyecto.data.resumen}
        </p>

        <ul class="reveal mt-8 flex flex-wrap gap-2" style="--reveal-delay:320ms">
          <li class="rounded-full bg-brand/15 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-brand">
            {estadoTexto[proyecto.data.estado] ?? proyecto.data.estado}
          </li>
          {
            proyecto.data.territorio && (
              <li class="rounded-full border border-mist/20 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-mist/75">
                {proyecto.data.territorio}
              </li>
            )
          }
          <li class="rounded-full border border-mist/20 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-mist/75">
            C.P.D. · desde 2012
          </li>
        </ul>
      </div>
    </header>

    <!-- ══════════ Cifras del proyecto (solo si el documento las respalda) ══════════ -->
    {
      proyecto.data.cifras.length > 0 && (
        <section class="border-b border-night-line bg-night-soft py-12" aria-label="Cifras del proyecto">
          <dl class="container-content grid gap-8 sm:grid-cols-3">
            {proyecto.data.cifras.map((c) => (
              <div class="border-l-2 border-brand pl-5">
                <dt class="text-xs font-bold uppercase tracking-[0.18em] text-mist/50">{c.etiqueta}</dt>
                <dd class="mt-2 text-4xl font-bold text-mist">{c.valor}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <!-- ══════════ Cuerpo + ficha técnica ══════════ -->
    <div class="container-content grid gap-14 py-16 lg:grid-cols-[300px_minmax(0,1fr)] lg:gap-20">
      <aside class="h-fit lg:sticky lg:top-28">
        <h2 class="text-xs font-bold uppercase tracking-[0.22em] text-ink/45">Ficha del proyecto</h2>

        <dl class="mt-6 divide-y divide-black/10 border-y border-black/10 text-sm">
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-ink/55">Línea</dt>
            <dd class="text-right font-bold">{proyecto.data.linea ?? '—'}</dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-ink/55">Periodo</dt>
            <dd class="text-right font-bold">{proyecto.data.periodo ?? '—'}</dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-ink/55">Territorio</dt>
            <dd class="text-right font-bold">{proyecto.data.territorio ?? '—'}</dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-ink/55">Estado</dt>
            <dd class="text-right font-bold">{estadoTexto[proyecto.data.estado] ?? proyecto.data.estado}</dd>
          </div>
        </dl>

        {
          proyecto.data.aliados.length > 0 && (
            <div class="mt-8">
              <h3 class="text-xs font-bold uppercase tracking-[0.22em] text-ink/45">Aliados</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {proyecto.data.aliados.map((a) => (
                  <li class="rounded-full bg-black/5 px-3 py-1 text-xs font-bold text-ink/70">{a}</li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="mt-10 rounded-2xl border border-black/10 bg-black/[0.02] p-6">
          <p class="text-sm font-bold">¿Quieres que este proyecto ocurra?</p>
          <p class="mt-2 text-sm text-ink/65">
            Buscamos aliados, empresas y cooperación que financien formación, materiales y operación.
          </p>
          <a
            href="/contacto"
            class="mt-4 inline-flex w-full items-center justify-center rounded-full bg-brand px-5 py-3 text-sm font-bold text-white transition hover:bg-brand-ink"
          >
            Hablar con la Corporación
          </a>
          <a href="/donaciones" class="mt-3 inline-block text-sm font-bold text-brand-ink hover:underline">
            Ver cómo donar →
          </a>
        </div>
      </aside>

      <div class="prose-cpd max-w-none">
        <Content />
      </div>
    </div>

    <!-- ══════════ Navegación entre proyectos ══════════ -->
    <nav class="border-t border-night-line bg-night py-14" aria-label="Otros proyectos">
      <div class="container-content grid gap-6 sm:grid-cols-2">
        <a href={`/proyectos/${anterior.id}`} class="group rounded-2xl border border-night-line p-6 transition hover:border-brand/50">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-mist/45">← Anterior</span>
          <p class="mt-2 text-lg font-bold text-mist">{anterior.data.titulo}</p>
        </a>
        <a href={`/proyectos/${siguiente.id}`} class="group rounded-2xl border border-night-line p-6 text-right transition hover:border-brand/50">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-mist/45">Siguiente →</span>
          <p class="mt-2 text-lg font-bold text-mist">{siguiente.data.titulo}</p>
        </a>
      </div>
    </nav>
  </article>

  <Footer slot="footer" />
</BaseLayout>
