---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import { readdirSync } from 'node:fs';
import { resolve } from 'node:path';

// Lee las fotos reales migradas del sitio antiguo (public/galeria/).
// Se usa process.cwd() porque en build el bundle vive en dist/ y las rutas
// relativas a import.meta.url apuntarían a dist/public (inexistente).
const galeriaDir = resolve(process.cwd(), 'public', 'galeria');

// Se importan los assets vía glob para que Astro los optimice en build
// (redimensiona y convierte a WebP) en vez de servirlos en bruto.
const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  '../../public/galeria/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const fotos = readdirSync(galeriaDir)
  .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
  .sort((a, b) => {
    const na = Number(a.match(/\d+/)?.[0] ?? 0);
    const nb = Number(b.match(/\d+/)?.[0] ?? 0);
    return nb - na;
  })
  .map((f) => ({
    src: imagenes[`../../public/galeria/${f}`]?.default,
    alt: `Registro fotográfico de actividades de la Corporación Pedagógica Diversidad (${f.replace(/\.[^.]+$/, '')})`,
  }))
  .filter((foto) => foto.src);
---

<BaseLayout
  title="Galería"
  description="Registro fotográfico de las actividades, jornadas y proyectos de la Corporación Pedagógica Diversidad."
>
  <Header slot="header" dark />

  <PageHero
    eyebrow="Registro fotográfico"
    title="Galería"
    description="Explora nuestra galería y conoce de cerca las actividades, jornadas y proyectos que desarrollamos junto a la comunidad."
  />

  <section class="container-content py-12">
    <p class="text-sm text-ink/50">{fotos.length} fotografías</p>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        fotos.map((foto) => (
          <li class="overflow-hidden rounded-xl border border-black/5 bg-black/[0.02]">
            <Image
              src={foto.src}
              alt={foto.alt}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              format="webp"
              quality={72}
              loading="lazy"
              decoding="async"
              class="h-56 w-full object-cover transition-transform duration-300 hover:scale-105"
            />
          </li>
        ))
      }
    </ul>

    <p class="mt-12 text-xs text-ink/50">
      [Títulos y descripciones definitivos pendientes de validación con el cliente]
    </p>
  </section>

  <Footer slot="footer" />
</BaseLayout>
