---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { readdirSync } from 'node:fs';
import { resolve } from 'node:path';

// Lee las fotos reales migradas del sitio antiguo (public/galeria/).
// Se usa process.cwd() porque en build el bundle vive en dist/ y las rutas
// relativas a import.meta.url apuntarían a dist/public (inexistente).
const galeriaDir = resolve(process.cwd(), 'public', 'galeria');

const fotos = readdirSync(galeriaDir)
  .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
  .sort((a, b) => {
    const na = Number(a.match(/\d+/)?.[0] ?? 0);
    const nb = Number(b.match(/\d+/)?.[0] ?? 0);
    return nb - na;
  })
  .map((f) => ({
    src: `/galeria/${f}`,
    alt: `Registro fotográfico de actividades de la Corporación Pedagógica Diversidad (${f.replace(/\.[^.]+$/, '')})`,
  }));
---

<BaseLayout
  title="Galería"
  description="Registro fotográfico de las actividades, jornadas y proyectos de la Corporación Pedagógica Diversidad."
>
  <Header slot="header" />

  <section class="container-content py-16">
    <h1 class="text-4xl">Galería</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink/75">
      Explora nuestra galería y conoce de cerca las actividades, jornadas y proyectos que
      desarrollamos junto a la comunidad.
    </p>

    <p class="mt-2 text-sm text-ink/50">{fotos.length} fotografías</p>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        fotos.map((foto) => (
          <li class="overflow-hidden rounded-xl border border-black/5 bg-black/[0.02]">
            <img
              src={foto.src}
              alt={foto.alt}
              loading="lazy"
              decoding="async"
              width="1024"
              height="684"
              class="h-56 w-full object-cover transition-transform duration-300 hover:scale-105"
            />
          </li>
        ))
      }
    </ul>

    <p class="mt-12 text-xs text-ink/50">
      [Títulos y descripciones definitivos pendientes de validación con el cliente]
    </p>
  </section>

  <Footer slot="footer" />
</BaseLayout>
