---
/**
 * Arte abstracto de cada proyecto.
 *
 * No hay fotografía disponible de estos proyectos (los PDF oficiales son
 * documentos de texto), así que la tarjeta se resuelve con una pieza gráfica
 * generada: fondo noche + resplandor de marca + una retícula geométrica
 * distinta por línea de trabajo. Cero peso de red (SVG inline), nítida en
 * cualquier pantalla y coherente con la home cinematográfica.
 */
interface Props {
  /** Línea de trabajo: define el patrón geométrico. */
  variante: 'educacion' | 'derechos' | 'impresion' | 'textiles' | 'agro' | 'parque' | 'papel' | 'finanzas';
  class?: string;
}

const { variante, class: clase } = Astro.props;

// Cada variante dibuja su retícula con bucles: menos código, mismo resultado.
const filas = (n: number) => Array.from({ length: n }, (_, i) => i);
---

<svg
  class:list={['h-full w-full', clase]}
  viewBox="0 0 1600 900"
  role="img"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid slice"
>
  <defs>
    <linearGradient id={`fondo-${variante}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#16131a"></stop>
      <stop offset="1" stop-color="#0d0b0e"></stop>
    </linearGradient>
    <radialGradient id={`brillo-${variante}`} cx="0.72" cy="0.18" r="0.75">
      <stop offset="0" stop-color="#f6006e" stop-opacity="0.55"></stop>
      <stop offset="0.55" stop-color="#f6006e" stop-opacity="0.10"></stop>
      <stop offset="1" stop-color="#f6006e" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <rect width="1600" height="900" fill={`url(#fondo-${variante})`}></rect>
  <rect width="1600" height="900" fill={`url(#brillo-${variante})`}></rect>

  <g stroke="#f4f1f3" stroke-width="2" fill="none">
    {
      variante === 'educacion' && (
        <>
          {filas(5).map((i) => (
            <path
              d={`M ${420 + i * 40} 760 A ${340 - i * 40} ${340 - i * 40} 0 0 1 ${1180 - i * 40} 760`}
              opacity={0.34 - i * 0.055}
            />
          ))}
          <line x1="800" y1="300" x2="800" y2="760" opacity="0.16" />
        </>
      )
    }
    {
      variante === 'derechos' && (
        <>
          {filas(7).map((i) => (
            <circle cx="800" cy="470" r={70 + i * 62} opacity={0.30 - i * 0.032} />
          ))}
          <line x1="800" y1="250" x2="800" y2="690" opacity="0.3" stroke="#f18322" />
        </>
      )
    }
    {
      variante === 'impresion' && (
        <>
          {filas(9).map((f) =>
            filas(16).map((c) => (
              <rect
                x={300 + c * 66}
                y={190 + f * 66}
                width="28"
                height="28"
                fill="#f4f1f3"
                stroke="none"
                opacity={Math.max(0.03, 0.26 - Math.abs(c - 8) * 0.02 - f * 0.012)}
              />
            ))
          )}
          <rect x="546" y="436" width="508" height="28" fill="#f6006e" stroke="none" opacity="0.85" />
        </>
      )
    }
    {
      variante === 'textiles' && (
        <>
          {filas(13).map((i) => (
            <line
              x1={260 + i * 90}
              y1="140"
              x2={140 + i * 90}
              y2="780"
              opacity={0.06 + (i % 4) * 0.05}
              stroke-width="10"
            />
          ))}
          {filas(5).map((i) => (
            <line x1="200" y1={260 + i * 110} x2="1400" y2={260 + i * 110} opacity="0.13" />
          ))}
        </>
      )
    }
    {
      variante === 'agro' && (
        <>
          {filas(7).map((i) => (
            <path
              d={`M 120 ${300 + i * 80} C 400 ${200 + i * 80}, 700 ${400 + i * 80}, 1000 ${300 + i * 80} S 1400 ${200 + i * 80}, 1500 ${300 + i * 80}`}
              opacity={0.09 + (i % 3) * 0.06}
            />
          ))}
          <circle cx="1210" cy="250" r="66" fill="#f18322" stroke="none" opacity="0.5" />
        </>
      )
    }
    {
      variante === 'parque' && (
        <>
          {filas(9).map((i) => (
            <rect
              x={260 + i * 120}
              y={640 - (i % 4) * 96 - 40}
              width="58"
              height={240 + (i % 4) * 96}
              fill="#f4f1f3"
              stroke="none"
              opacity={0.05 + (i % 4) * 0.04}
            />
          ))}
          <line x1="200" y1="840" x2="1400" y2="840" opacity="0.28" />
        </>
      )
    }
    {
      variante === 'papel' && (
        <>
          {filas(4).map((i) => (
            <rect
              x={620 + i * 34}
              y={250 + i * 34}
              width="420"
              height="330"
              rx="6"
              opacity={0.4 - i * 0.07}
              transform={`rotate(${i * 3.5} 830 415)`}
            />
          ))}
          <line x1="700" y1="360" x2="980" y2="360" opacity="0.5" stroke="#f18322" />
          <line x1="700" y1="410" x2="930" y2="410" opacity="0.35" />
          <line x1="700" y1="460" x2="960" y2="460" opacity="0.35" />
        </>
      )
    }
    {
      variante === 'finanzas' && (
        <>
          {filas(7).map((i) => (
            <rect
              x={340 + i * 130}
              y={700 - (i + 1) * 62}
              width="62"
              height={(i + 1) * 62}
              fill="#f4f1f3"
              stroke="none"
              opacity={0.07 + i * 0.03}
            />
          ))}
          <path
            d="M 371 640 L 501 578 L 631 520 L 761 448 L 891 400 L 1021 320 L 1151 250"
            stroke="#f6006e"
            stroke-width="5"
            opacity="0.9"
          />
        </>
      )
    }
  </g>

</svg>
