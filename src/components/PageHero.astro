---
/**
 * Cabecera de página editorial (banda + fotografía de fondo con parallax).
 *
 * Desde 2026-11-13 usa la MISMA configuración que el hero del inicio, a pedido
 * de Ney: la foto va a sangre, detrás del texto, con `data-parallax="0.18"` y
 * la imagen al 118 % de alto desplazada -6 %. El velo (`hero-pagina-velo`) es
 * el que garantiza el contraste del texto: cerrado donde va el texto pequeño
 * (antetítulo y descripción) y abierto en la franja del titular.
 *
 * El contenido es visible por defecto: los `reveal` sólo se animan si el motor
 * de scroll está activo (clase .js-reveal en <html>).
 */
import { Image } from 'astro:assets';

interface Props {
  /** Antetítulo corto en mayúsculas (ej: "Quiénes somos"). */
  eyebrow?: string;
  title: string;
  description?: string;
  /** Foto de fondo. Si no se pasa, la cabecera queda como banda lisa. */
  image?: ImageMetadata;
}

const { eyebrow, title, description, image } = Astro.props;
---

<section class="relative overflow-hidden border-b border-night-line bg-night text-mist">
  {
    image && (
      <div class="absolute inset-0" data-parallax="0.18">
        <Image
          src={image}
          alt=""
          aria-hidden="true"
          widths={[640, 960, 1280, 1600]}
          sizes="100vw"
          class="hero-pagina-media h-[118%] w-full -translate-y-[6%] object-cover"
        />
      </div>
    )
  }
  {image && <div class="hero-pagina-velo absolute inset-0" aria-hidden="true"></div>}

  <div class="container-content relative z-10 py-16 sm:py-24">
    {
      eyebrow && (
        <p class="hero-eyebrow reveal text-xs font-bold uppercase tracking-[0.3em] text-brand">
          {eyebrow}
        </p>
      )
    }

    <h1 class="mt-6 text-display font-bold">
      <span class="line-mask"><span class="line-inner">{title}</span></span>
    </h1>

    {
      description && (
        <p
          class="reveal mt-6 max-w-3xl text-lg leading-relaxed text-mist/70"
          style="--reveal-delay:220ms"
        >
          {description}
        </p>
      )
    }

    <slot />
  </div>
</section>
