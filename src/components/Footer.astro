---
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-black/5 bg-black/[0.02]">
  <div class="container-content grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class="text-lg font-bold text-brand">CPD</p>
      <p class="mt-2 text-sm text-ink/70">
        Corporación Pedagógica Diversidad — educación inclusiva y salud mental para jóvenes.
      </p>
    </div>

    <nav aria-label="Enlaces del sitio">
      <h2 class="text-sm font-bold uppercase tracking-wide text-ink/60">Sitio</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/nosotros" class="text-ink/80 hover:text-brand">Nosotros</a></li>
        <li><a href="/proyectos" class="text-ink/80 hover:text-brand">Proyectos</a></li>
        <li><a href="/eventos" class="text-ink/80 hover:text-brand">Eventos</a></li>
        <li><a href="/donaciones" class="text-ink/80 hover:text-brand">Donaciones</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wide text-ink/60">Contacto</h2>
      <ul class="mt-3 space-y-2 text-sm text-ink/80">
        <li><a href="/contacto" class="hover:text-brand">Formulario de contacto</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-black/5">
    <p class="container-content py-6 text-xs text-ink/60">
      © {year} Corporación Pedagógica Diversidad. Todos los derechos reservados.
    </p>
  </div>
</footer>
