---
import { Image } from 'astro:assets';
import logotipoPixell from '../assets/logotipo-pixell.png';

interface Props {
  /** true = pie sobre fondo oscuro (necesario en la home cinematográfica). */
  dark?: boolean;
}

const { dark = false } = Astro.props;

const year = new Date().getFullYear();
---

<footer
  class:list={[
    'border-t',
    dark ? 'border-night-line bg-night text-mist' : 'mt-16 border-black/5 bg-black/[0.02]',
  ]}
>
  <div class="container-content grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class:list={['text-lg font-bold', dark ? 'text-mist' : 'text-brand-ink']}>CPD</p>
      <p class:list={['mt-2 text-sm', dark ? 'text-mist/60' : 'text-ink/70']}>
        Corporación Pedagógica Diversidad — educación inclusiva y salud mental para jóvenes.
      </p>
    </div>

    <nav aria-label="Enlaces del sitio">
      <h2 class:list={['text-sm font-bold uppercase tracking-wide', dark ? 'text-mist/50' : 'text-ink/60']}>
        Sitio
      </h2>
      <ul class:list={['mt-3 space-y-2 text-sm', dark ? 'text-mist/80' : 'text-ink/80']}>
        <li><a href="/nosotros" class="hover:text-brand">Nosotros</a></li>
        <li><a href="/proyectos" class="hover:text-brand">Proyectos</a></li>
        <li><a href="/eventos" class="hover:text-brand">Eventos</a></li>
        <li><a href="/donaciones" class="hover:text-brand">Donaciones</a></li>
      </ul>
    </nav>

    <div>
      <h2 class:list={['text-sm font-bold uppercase tracking-wide', dark ? 'text-mist/50' : 'text-ink/60']}>
        Contacto
      </h2>
      <ul class:list={['mt-3 space-y-2 text-sm', dark ? 'text-mist/80' : 'text-ink/80']}>
        <li><a href="/contacto" class="hover:text-brand">Formulario de contacto</a></li>
      </ul>
    </div>
  </div>

  <div class:list={['border-t', dark ? 'border-night-line' : 'border-black/5']}>
    <div
      class="container-content flex flex-col gap-4 py-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class:list={['text-xs', dark ? 'text-mist/50' : 'text-ink/60']}>
        © {year} Corporación Pedagógica Diversidad. Todos los derechos reservados.
      </p>

      <!-- Crédito provisional — logotipo de Pixell enlazado a su sitio; pendiente la marca definitiva. -->
      <p class:list={['flex items-center gap-3 text-xs', dark ? 'text-mist/50' : 'text-ink/60']}>
        <span>Diseño y desarrollo</span>
        <a
          href="https://pixell.mork.click"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center transition-opacity hover:opacity-80"
        >
          <Image
            src={logotipoPixell}
            alt="Pixell"
            widths={[90, 180]}
            sizes="80px"
            class="h-6 w-auto"
            loading="lazy"
          />
        </a>
      </p>
    </div>
  </div>
</footer>
