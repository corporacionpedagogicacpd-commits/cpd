{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/expo", "destination": "/expo/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "expo.corpedagogicadiversidad.org" }],
      "destination": "/expo/$1"
    }
  ]
}
